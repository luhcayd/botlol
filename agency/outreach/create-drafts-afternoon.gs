function createReeloAfternoonDrafts() {
  var made = 0;
  for (var i = 0; i < REELO_AFTERNOON.length; i++) {
    var e = REELO_AFTERNOON[i];
    if (!e.to || e.to.indexOf('@') === -1) { continue; }
    GmailApp.createDraft(e.to, e.subject, e.body);
    made++;
    Utilities.sleep(400);
  }
  Logger.log(made + ' afternoon drafts created. Check Gmail > Drafts.');
}
